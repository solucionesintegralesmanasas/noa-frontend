{
  "name": "nextfuec-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:a11y": "node scripts/a11y-audit.js",
    "test:perf": "node scripts/perf-budget.js",
    "test:perf:strict": "node scripts/perf-budget.js --strict",
    "test:unit": "vitest run",
    "perf:budget:local": "node scripts/perf-budget.js",
    "perf:budget:prod": "node scripts/perf-budget.js --url=https://apptransportessinbarreras.transportessinbarreras.com",
    "perf:lighthouse": "node scripts/lighthouse.js",
    "test": "node scripts/a11y-audit.js && node scripts/perf-budget.js && eslint . && npm run test:unit",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:assets": "npx capacitor-assets generate --android --ios",
    "ionic:build": "ionic build",
    "ionic:sync": "ionic cap sync"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.16.1",
    "dayjs": "^1.11.21",
    "html2canvas": "^1.4.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@ionic/cli": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "proxy-agent": "^8.0.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.8.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
